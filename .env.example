# KYDORA website — μεταβλητές περιβάλλοντος.
# Στο Vercel: Settings -> Environment Variables. Ποτέ μέσα στον κώδικα.

# --- Ανάγνωση ακινήτων (connection "KYDORA Website") ---
# Δικαιώματα: ΜΟΝΟ "Read content". No user information.
# Content access: μόνο η βάση KYDORA Properties.
NOTION_TOKEN=
NOTION_PROPERTIES_DB=a5298196f71f41bd9e7738baccd3745a

# --- Εγγραφή leads (ΞΕΧΩΡΙΣΤΗ connection "KYDORA Website Forms") ---
# Δικαιώματα: ΜΟΝΟ "Insert content". Χωρίς Read, χωρίς Update.
# Content access: μόνο η βάση KYDORA Επαφές & Leads.
# Δύο ξεχωριστά κλειδιά ώστε το ένα να μη μπορεί να κάνει τη δουλειά του άλλου.
NOTION_LEADS_TOKEN=
NOTION_LEADS_DB=fc23dfd2f0764a869424966aff059609

# --- Ειδοποίηση με email όταν έρχεται lead (Resend) ---
# Χωρίς αυτές, η φόρμα δουλεύει κανονικά — απλώς δεν στέλνει ειδοποίηση.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
# Προαιρετικό. Μέχρι να επαληθευτεί το kydora.gr στο Resend, μένει το προεπιλεγμένο.
LEAD_NOTIFY_FROM=

# --- Διεύθυνση site ---
SITE_URL=

# --- Δημοσίευση ---
# ΠΡΟΣΟΧΗ: μένει false μέχρι την ημέρα του launch.
# Με false: noindex σε κάθε σελίδα, robots.txt απαγορευτικό, κανένα sitemap.
SITE_PUBLIC=false
