# Αντίγραψε σε .env.local για τοπική ανάπτυξη.
# Στο Vercel μπαίνουν ως Environment Variables — ποτέ μέσα στον κώδικα.

# Notion integration token (read-only). Δημιουργείται στο Notion → Integrations.
NOTION_TOKEN=

# ID της βάσης KYDORA Properties (από το URL της βάσης).
NOTION_PROPERTIES_DB=

# Η διεύθυνση του site. Στο staging: το vercel.app URL.
SITE_URL=https://kydora.gr

# ΜΗΝ το αλλάξεις σε true πριν την ημέρα του launch.
# Όσο λείπει ή είναι false, το site στέλνει noindex και μπλοκάρει τα robots.
SITE_PUBLIC=false
